         </property>
         <property name="plainText">
          <string>Шаг 1. Запуск программы
Откройте исполняемый файл приложения.</string>
         </property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="tab_step3">
      <attribute name="title">
       <string>04 Шаблон</string>
      </attribute>
      <layout class="QVBoxLayout" name="step3Layout">
       <item>
        <widget class="QTextEdit" name="textStep3">
         <property name="styleSheet">
