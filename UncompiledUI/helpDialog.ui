  <property name="styleSheet">
   <string notr="true">QDialog {
	background: #0a192f;
}
QLabel {
	font: 20pt 'InterI';
    color: #ffffff;
    padding-bottom: 8px;
    border-bottom: 2px solid #64ffda;
}
QPushButton {
            background-color: #1e293b;
            border: 1px solid #3d4044;
            border-radius: 8px;
            padding: 10px 18px;
            color: #f1f5f9;
            font: 500 11pt 'Inter', 'Segoe UI', 'Yu Gothic UI';
          }
          QPushButton:hover {
              background: rgba(100,255,218,0.3);
          }
          QPushButton:pressed {
              background: rgba(100,255,218,0.5);
          }
QCheckBox {
              color: #ffffff;
              font: 12pt 'Inter';
          }
          QCheckBox::indicator {
              width: 20px;
              height: 20px;
              border-radius: 6px;
              background-color: rgb(255, 255, 255);
          }
          	QCheckBox::indicator:checked {
             	background-color: #2dd4bf;
          	}
		  	QCheckBox::indicator:unchecked {
				background-color: rgb(5, 14, 25)
			}
          QCheckBox::indicator:hover {
              background-color: rgb(156, 212, 191)
          }
		 QCheckBox::indicator:pressed {
			 background-color: rgb(52, 247, 221)
		 }

        QTabWidget::pane {
            background: #050e19;
            border-radius: 16px;
            margin-top: 12px;
            padding: 20px;
        }
        QTabBar::tab {
            background: transparent;
            color: #8a9bb5;
            font: 12pt 'Inter';
            padding: 8px 20px;
            margin-right: 8px;
        }
        QTabBar::tab:selected {
            color: #2dd4bf;
            font-weight: bold;
            border-bottom: 3px solid #64ffda;
        }
        QTabBar::tab:hover {
            color: rgb(156, 212, 191);
        }
QTextEdit {
	background: transparent;
    color: #ffffff;
    font: 12pt 'Inter';
    border: none;
}</string>
  </property>
